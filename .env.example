# Modèle des variables d'environnement. Copier ce fichier en .env.local et le compléter.
# En production, ces variables sont saisies dans Coolify (jamais dans Git).

# Connexion à PostgreSQL (en local : base lancée par `npm run db`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/abm"

# Clé secrète des sessions : une longue chaîne aléatoire, différente en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Adresse publique du site (https://bilicence.fr en production)
BETTER_AUTH_URL="http://localhost:3000"

# Envoi d'e-mails (Brevo, SMTP). Vide = e-mails affichés dans le terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_EXPEDITEUR="ABM <contact@bilicence.fr>"

# Dossier où sont rangées les images téléversées (volume persistant Coolify en production)
UPLOAD_DIR="./uploads"

# Développement uniquement : mot de passe des comptes de test créés par `npm run db:remplir`
SEED_MOT_DE_PASSE=""
